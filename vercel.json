{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://sohamratnaparkhi-blog.vercel.app/blog"
    },
    {
      "source": "/blog/(.*)",
      "destination": "https://sohamratnaparkhi-blog.vercel.app/blog/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
